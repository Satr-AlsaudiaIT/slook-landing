{
  "name": "slook-landing",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "clean": "rm -rf .next out",
    "clean:deps": "rm -rf node_modules .next out",
    "docker:build": "docker build -t slook-landing .",
    "docker:run": "docker run --rm -p 3000:3000 -v $(pwd)/data:/app/data --env-file .env.local slook-landing",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f slook",
    "docker:clean": "docker compose down --rmi all --remove-orphans 2>/dev/null || true; docker rmi -f slook-landing:latest 2>/dev/null || true; docker builder prune -f",
    "docker:reset": "npm run docker:clean && docker compose down -v 2>/dev/null; rm -rf data && docker builder prune -af",
    "docker:ps": "docker compose ps"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@emotion/cache": "^11.13.1",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@mui/material-nextjs": "^6.1.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.10",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.16.0",
    "next": "^15.0.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
