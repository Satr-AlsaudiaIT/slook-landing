# Keep the build context tiny — everything below is excluded.

# deps and build output
node_modules
.next
out
build
dist

# version control
.git
.gitignore
.gitattributes

# env files (passed in at runtime via --env-file, NOT baked into image)
.env
.env.*
!.env.example

# runtime data — created fresh inside the container, mounted as a volume
data
*.db
*.db-journal
*.db-shm
*.db-wal

# editors / OS
.vscode
.idea
.DS_Store
*.swp
*.swo
Thumbs.db

# misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage
.nyc_output

# don't recursively copy the docker config itself
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
