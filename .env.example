# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# --- Admin auth ---
# Used to seed the default admin user on first DB init.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=slook2026

# iron-session encryption secret. MUST be at least 32 characters in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-32+-character-random-string

# --- Database ---
# Defaults to ./data/slook.db if unset.
# DB_PATH=/var/lib/slook/slook.db

# --- SMTP (optional — leave blank for dry-run mode that logs to console) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Slook <no-reply@slook.sa>
